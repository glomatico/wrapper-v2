# Optional advanced settings. No .env file is needed for a fresh installation.
# The build helper tags the image as wrapper-v2:local automatically.
# WRAPPER_IMAGE=wrapper-v2:1.0.1-local-arm64
# WRAPPER_DEVICE_INFO=Music/4.9/Android/10/Samsung S9/7663313/en-US/en-US/your-stable-guid
# If you already have a session volume from the old Wrapper, keep both its
# existing WRAPPER_DEVICE_INFO and WRAPPER_DATA_DIR rather than starting fresh.
# Optional auto-login: uncomment BOTH lines and provide nonempty values.
# Leaving these defined but empty prevents the server from starting.
# WRAPPER_USERNAME=
# WRAPPER_PASSWORD=
# WRAPPER_DNS=1.1.1.1,8.8.8.8
# RUST_LOG=info
# WRAPPER_HTTP_PORT=8080
# WRAPPER_UID=1000
# WRAPPER_GID=1000
# WRAPPER_DATA_DIR=./data  # optional legacy bind mount instead of named volume
