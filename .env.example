# Copy to .env, edit for your architecture, and keep private (already gitignored).
# Values below assume an x86_64 build. For ARM64, use:
# WRAPPER_IMAGE=wrapper-v2:1.0.0-local-arm64
# WRAPPER_ROOTFS_DIR=./build/arm64-v8a/rootfs
# WRAPPER_UID and WRAPPER_GID must own ./data and the staged session directory.
WRAPPER_IMAGE=wrapper-v2:1.0.0-local-amd64
WRAPPER_DEVICE_INFO=
# Optional auto-login: uncomment BOTH lines and provide nonempty values.
# Leaving these defined but empty prevents the server from starting.
# WRAPPER_USERNAME=
# WRAPPER_PASSWORD=
WRAPPER_DNS=1.1.1.1,8.8.8.8
RUST_LOG=info
WRAPPER_HTTP_PORT=8080
WRAPPER_UID=1000
WRAPPER_GID=1000
WRAPPER_ROOTFS_DIR=./build/x86_64/rootfs
WRAPPER_DATA_DIR=./data
