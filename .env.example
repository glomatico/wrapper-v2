# Copy to .env, edit, and keep private (already gitignored).
# WRAPPER_UID and WRAPPER_GID must match the owner of ./data and the staged
# rootfs session directory (the default is 1000:1000).
WRAPPER_DEVICE_INFO=
# Optional: both required together for automatic session login on startup.
# Keep credentials in a private env_file (never in Git or Docker Compose).
WRAPPER_USERNAME=
WRAPPER_PASSWORD=
WRAPPER_DNS=1.1.1.1,8.8.8.8
RUST_LOG=info
WRAPPER_HTTP_PORT=80
WRAPPER_UID=1000
WRAPPER_GID=1000
WRAPPER_ROOTFS_DIR=./build/rootfs
WRAPPER_DATA_DIR=./data
